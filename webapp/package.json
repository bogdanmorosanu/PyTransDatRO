{
  "name": "webapp",
  "private": true,
  "version": "1.0.0-beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "tsc && vite build --outDir dist-e2e",
    "test:e2e": "tsc -p e2e && playwright test",
    "test:e2e:ui": "tsc -p e2e && playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "24.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "nouislider": "^15.8.1"
  }
}
