# ==============================================================================
# PyTransDatRO Web Application Client Configuration
# ==============================================================================
# Copy this file to webapp/.env to override client-side defaults.
# All environment variables must begin with VITE_.
# ==============================================================================

# API Base URL (leave empty for same-origin proxy or standard production deployments)
VITE_API_BASE_URL=

# Warning threshold count for batch rendering on Leaflet map
VITE_BATCH_WARNING_THRESHOLD=2000
