# ==============================================================================
# PyTransDatRO - Unified Application & Deployment Configuration
# ==============================================================================
# Copy this file to .env to override default parameters.
# Single entrypoint for Backend, Web Client, and Containerization stack.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container & Reverse Proxy Deployment
# ------------------------------------------------------------------------------
# Host port mapped to the Nginx web container (e.g. 8000 for local dev/testing, 80 on prod)
WEBAPP_PORT=8000
# Maximum request body size accepted by Nginx (e.g. 50M; matches PYTRANSDAT_MAX_FILE_UPLOAD_BYTES)
NGINX_CLIENT_MAX_BODY_SIZE=50M

# ------------------------------------------------------------------------------
# 2. Backend Server Network & Process Settings (PYTRANSDAT_*)
# ------------------------------------------------------------------------------
PYTRANSDAT_HOST=0.0.0.0
PYTRANSDAT_PORT=8000
PYTRANSDAT_LOG_LEVEL=INFO

# Security & CORS Origins (JSON list or comma-separated string)
PYTRANSDAT_CORS_ORIGINS=["*"]

# In-Memory Sliding Window Rate Limiting
PYTRANSDAT_RATE_LIMIT_WINDOW_SECONDS=60.0
PYTRANSDAT_RATE_LIMIT_POINT=60
PYTRANSDAT_RATE_LIMIT_BATCH=10

# Transformation Volume Caps
PYTRANSDAT_MAX_BATCH_POINTS=20000
PYTRANSDAT_MAX_FILE_POINTS=100000
PYTRANSDAT_MAX_FILE_UPLOAD_BYTES=52428800

# Telemetry & Logging Paths (log files derive from PYTRANSDAT_LOG_DIR unless overridden)
PYTRANSDAT_LOG_DIR=./logs
# PYTRANSDAT_LEGACY_DB_PATH=./logs/legacy_stats.db
# PYTRANSDAT_FEEDBACK_LOG_PATH=./logs/feedback.jsonl
# PYTRANSDAT_TELEMETRY_FALLBACK_PATH=./logs/telemetry_fallback.jsonl
PYTRANSDAT_APP_LOG_ENABLED=true
# PYTRANSDAT_APP_LOG_PATH=./logs/app.log
PYTRANSDAT_APP_LOG_MAX_BYTES=10485760
PYTRANSDAT_APP_LOG_BACKUP_COUNT=5

# SMTP Feedback Email Delivery (optional; leaving empty keeps feedback purely in logs/feedback.jsonl)
# PYTRANSDAT_SMTP_HOST=smtp.example.com
# PYTRANSDAT_SMTP_PORT=587
# PYTRANSDAT_SMTP_USER=user@example.com
# PYTRANSDAT_SMTP_PASSWORD=secret
# PYTRANSDAT_SMTP_USE_TLS=true
# PYTRANSDAT_FEEDBACK_RECIPIENT_EMAIL=admin@example.org
# PYTRANSDAT_FEEDBACK_SENDER_EMAIL=pytransdat@example.org

# Static Web Application Assets (default: <repo>/webapp/dist; relative paths resolve against <repo>)
# PYTRANSDAT_WEBAPP_DIST_DIR=webapp/dist

# ------------------------------------------------------------------------------
# 3. Web Application Client Settings (VITE_*)
# ------------------------------------------------------------------------------
# API Base URL (leave empty for same-origin proxy or standard production deployments)
VITE_API_BASE_URL=
# Application display branding
VITE_APP_NAME=PyTransDatRO
# Repository URL for help & issue reporting
VITE_REPO_URL=https://github.com/bogdanmorosanu/PyTransDatRO
# Warning threshold count for batch rendering on Leaflet map
VITE_BATCH_WARNING_THRESHOLD=2000
# Number of coordinates to sample when user selects 'sample' on large batches
VITE_BATCH_SAMPLE_SIZE=1000
# Default map center (Romania centroid)
VITE_DEFAULT_MAP_LAT=45.9432
VITE_DEFAULT_MAP_LON=24.9668
VITE_DEFAULT_MAP_ZOOM=7
VITE_POINT_ZOOM_LEVEL=14
# Background health poll interval in milliseconds
VITE_HEALTH_POLL_MS=30000
