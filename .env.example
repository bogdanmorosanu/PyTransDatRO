# ==============================================================================
# PyTransDatRO Web Service & Deployment Configuration
# ==============================================================================
# Copy this file to .env to override default configuration parameters.
# All backend environment variables are prefixed with PYTRANSDAT_.
# ==============================================================================

# Docker & Host Deployment Port
# Port on the host server mapped to the Nginx web application container
# (e.g., 8000 for local testing, 80 or 8080 on production, 80 on dedicated servers)
WEBAPP_PORT=8000

# Server Network & Process Settings
PYTRANSDAT_HOST=0.0.0.0
PYTRANSDAT_PORT=8000
PYTRANSDAT_LOG_LEVEL=INFO

# Security & CORS Origins (JSON list or comma-separated string)
PYTRANSDAT_CORS_ORIGINS=["*"]

# In-Memory Sliding Window Rate Limiting
PYTRANSDAT_RATE_LIMIT_WINDOW_SECONDS=60.0
PYTRANSDAT_RATE_LIMIT_POINT=60
PYTRANSDAT_RATE_LIMIT_BATCH=10

# Transformation Volume Caps
PYTRANSDAT_MAX_BATCH_POINTS=20000
PYTRANSDAT_MAX_FILE_POINTS=100000
PYTRANSDAT_MAX_FILE_UPLOAD_BYTES=52428800

# Telemetry & Logging Paths
PYTRANSDAT_LOG_DIR=./logs
PYTRANSDAT_LEGACY_DB_PATH=./logs/legacy_stats.db
PYTRANSDAT_FEEDBACK_LOG_PATH=./logs/feedback.jsonl
PYTRANSDAT_TELEMETRY_FALLBACK_PATH=./logs/telemetry_fallback.jsonl
PYTRANSDAT_APP_LOG_ENABLED=true
PYTRANSDAT_APP_LOG_PATH=./logs/app.log
PYTRANSDAT_APP_LOG_MAX_BYTES=10485760
PYTRANSDAT_APP_LOG_BACKUP_COUNT=5

# SMTP Feedback Email Delivery (optional; leaving empty keeps feedback purely in logs/feedback.jsonl)
# PYTRANSDAT_SMTP_HOST=smtp.example.com
# PYTRANSDAT_SMTP_PORT=587
# PYTRANSDAT_SMTP_USER=user@example.com
# PYTRANSDAT_SMTP_PASSWORD=secret
# PYTRANSDAT_SMTP_USE_TLS=true
# PYTRANSDAT_FEEDBACK_RECIPIENT_EMAIL=admin@example.org
# PYTRANSDAT_FEEDBACK_SENDER_EMAIL=pytransdat@example.org

# Static Web Application Assets (default: <repo>/webapp/dist; relative paths resolve against <repo>)
# PYTRANSDAT_WEBAPP_DIST_DIR=webapp/dist
